{
  "name": "neverdrop",
  "version": "1.1.0",
  "description": "Multi-LLM desktop chat with provider failover, MCP host client, and local SQLite history",
  "main": "dist-electron/main.js",
  "author": "duke-haderach",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -n vite,electron -c cyan,yellow \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/generative-ai": "^0.21.0",
    "better-sqlite3": "^11.3.0",
    "keytar": "^7.9.0",
    "openai": "^4.67.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^29.4.6",
    "electron-builder": "^25.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.duke-haderach.neverdrop",
    "productName": "NeverDrop",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "win": { "target": ["nsis", "portable"] },
    "mac": { "target": "dmg", "arch": ["x64", "arm64"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
